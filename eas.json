{
  "cli": {
    "version": ">= 18.5.0",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "node": "22.14.0"
    },
    "development": {
      "extends": "base",
      "environment": "development",
      "channel": "development",
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://example.com/api"
      }
    },
    "staging-preview": {
      "extends": "base",
      "environment": "staging",
      "channel": "staging",
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://staging.example.com/api"
      }
    },
    "production": {
      "extends": "base",
      "environment": "production",
      "channel": "production",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://api.example.com/api"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
