{
  "expo": {
    "name": "NepalCanBlog",
    "icon": "./assets/images/logo.png",
    "slug": "expo-react-native-boilerplate",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "expoboilerplate",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.example.expoboilerplate",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/logo.png",
        "backgroundColor": "#EDE9FE"
      },
      "package": "com.example.expoboilerplate",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow the app to access your photos to choose a blog cover image."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo.png",
          "imageWidth": 160,
          "backgroundColor": "#F9F9FF"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ca4341fe-c734-44c7-ab29-ef9887e0f451"
      },
      "API_URL": "http://localhost:5000/api"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/ca4341fe-c734-44c7-ab29-ef9887e0f451"
    },
    "owner": "amrtz"
  }
}
