{
  "expo": {
    "name": "NepalCanBlog",
    "slug": "nepalcanblog",
    "icon": "./assets/images/logo.png",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "nepalcanblog",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nepalcan.blog",
      "associatedDomains": ["applinks:blog-ncc19.vercel.app"],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/logo.png",
        "backgroundColor": "#EDE9FE"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "blog-ncc19.vercel.app",
              "pathPrefix": "/profile"
            },
            {
              "scheme": "https",
              "host": "blog-ncc19.vercel.app",
              "pathPrefix": "/reset-password"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ],
      "package": "com.nepalcan.blog"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow NepalCanBlog to take photos for your blog.",
          "photosPermission": "Allow the app to access your photos to choose a blog cover image."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo.png",
          "imageWidth": 160,
          "backgroundColor": "#F9F9FF"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3353958b-672e-4ec7-8136-59b3bc33cd79"
      },
      "API_URL": "https://blog-gxe2.onrender.com/api"
    },
    "owner": "amrtz"
  }
}
